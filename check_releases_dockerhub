#!/usr/bin/env bash

RELEASES_FILE="$HOME/Nextcloud/releases_dockerhub"
# # App[repository]:image:version
# Gitlab[https://github.com/lautarobarba/gitlab-container]:gitlab/gitlab-ce:18.6.4-ce.0
# Portainer[https://github.com/lautarobarba/portainer-swarm-container]:portainer/portainer-ce:2.21.5
# Traefik[https://github.com/lautarobarba/traefik-swarm-container]:traefik:v3.7
# Nextcloud[https://github.com/lautarobarba/nextcloud-container]:nextcloud:32.0


HEADER_REPO="Repo URL"
HEADER_IMAGE="Image"
HEADER_CURRENT="Current"
HEADER_LATEST="Latest"

REPO_URL=()
IMAGE_NAME=()
CURRENT_VER=()
LATEST_VER=()
STATUS=()
# Anchos minimos: el largo de cada encabezado
MAX_REPO=${#HEADER_REPO}
MAX_IMAGE=${#HEADER_IMAGE}
MAX_CURRENT=${#HEADER_CURRENT}
MAX_LATEST=${#HEADER_LATEST}

resolve_image() {
    local image="$1"
    if [[ "$image" != */* ]]; then
        echo "library/${image}"
    else
        echo "$image"
    fi
}

# Construye la expresion regular que describe la version actual:
# mismo prefijo (v), misma cantidad de componentes y mismo sufijo.
#   6.6.2       -> ^[0-9]+(\.[0-9]+){2}$
#   32.0        -> ^[0-9]+(\.[0-9]+){1}$
#   v3.7.6      -> ^v[0-9]+(\.[0-9]+){2}$
#   18.6.4-ce.0 -> ^[0-9]+(\.[0-9]+){2}-ce\.[0-9]+$
version_pattern() {
    local current="$1"
    local prefix="" core suffix suffix_re=""

    if [[ "$current" == v[0-9]* ]]; then
        prefix="v"
        current="${current#v}"
    fi

    [[ "$current" =~ ^([0-9]+(\.[0-9]+)*) ]] || return 1
    core="${BASH_REMATCH[1]}"
    suffix="${current#"$core"}"

    local dots="${core//[^.]/}"
    local depth=${#dots}

    if [[ -n "$suffix" ]]; then
        # Escapa los metacaracteres y generaliza los numeros del sufijo
        suffix_re=$(printf '%s' "$suffix" |
            sed -E -e 's/[][(){}.*+?^$|\\]/\\&/g' -e 's/[0-9]+/[0-9]+/g')
    fi

    printf '^%s[0-9]+(\\.[0-9]+){%d}%s$' "$prefix" "$depth" "$suffix_re"
}

# El registry devuelve todos los tags en una sola llamada.
# Si falla se usa la API de Docker Hub (solo la primera pagina).
fetch_tags() {
    local api_image="$1" token="" tags=""

    token=$(curl -s --max-time 15 \
        "https://auth.docker.io/token?service=registry.docker.io&scope=repository:${api_image}:pull" |
        jq -r '.token // empty' 2>/dev/null)

    if [[ -n "$token" ]]; then
        tags=$(curl -s --max-time 30 -H "Authorization: Bearer ${token}" \
            "https://registry-1.docker.io/v2/${api_image}/tags/list" |
            jq -r '.tags[]?' 2>/dev/null)
    fi

    if [[ -z "$tags" ]]; then
        tags=$(curl -s --max-time 15 \
            "https://registry.hub.docker.com/v2/repositories/${api_image}/tags?page_size=100" |
            jq -r '.results[]?.name' 2>/dev/null)
    fi

    printf '%s\n' "$tags"
}

check_release() {
    local image="$1" current="$2"

    local pattern
    pattern=$(version_pattern "$current") || {
        echo "ERROR"
        return 1
    }

    local api_image tags
    api_image=$(resolve_image "$image")
    tags=$(fetch_tags "$api_image")

    if [[ -z "$tags" ]]; then
        echo "ERROR"
        return 1
    fi

    local latest
    latest=$(printf '%s\n' "$tags" | grep -E "$pattern" | sort -V | tail -n1)

    if [[ -z "$latest" ]]; then
        echo "ERROR"
        return 1
    fi

    echo "$latest"
    return 0
}

while IFS= read -r line; do
    [[ "$line" =~ ^#.* ]] && continue
    [[ -z "$line" ]] && continue

    repo_with_rest="${line#*[}"
    repo="${repo_with_rest%%]*}"
    rest="${repo_with_rest#*]:}"
    image="${rest%:*}"
    version="${rest##*:}"

    echo -n "Checking ${image}... " >&2
    latest=$(check_release "$image" "$version")
    echo "${latest}" >&2
    if [[ "$latest" == "ERROR" ]]; then
        status="ERROR"
    elif [[ "$version" == "$latest" ]]; then
        status="OK"
    elif [[ "$(printf '%s\n%s\n' "$version" "$latest" | sort -V | tail -n1)" == "$version" ]]; then
        # La version instalada es mas nueva que el ultimo tag encontrado
        status="OK"
    else
        status="Update Available"
    fi

    REPO_URL+=("$repo")
    IMAGE_NAME+=("$image")
    CURRENT_VER+=("$version")
    LATEST_VER+=("$latest")
    STATUS+=("$status")

    (( ${#repo} > MAX_REPO )) && MAX_REPO=${#repo}
    (( ${#image} > MAX_IMAGE )) && MAX_IMAGE=${#image}
    (( ${#version} > MAX_CURRENT )) && MAX_CURRENT=${#version}
    (( ${#latest} > MAX_LATEST )) && MAX_LATEST=${#latest}
done < "$RELEASES_FILE"

printf "%-${MAX_REPO}s  %-${MAX_IMAGE}s  %-${MAX_CURRENT}s  %-${MAX_LATEST}s  %s\n" \
    "$HEADER_REPO" "$HEADER_IMAGE" "$HEADER_CURRENT" "$HEADER_LATEST" "Status"
printf "%-${MAX_REPO}s  %-${MAX_IMAGE}s  %-${MAX_CURRENT}s  %-${MAX_LATEST}s  %s\n" \
    "$(printf '%*s' "$MAX_REPO" '' | tr ' ' '-')" \
    "$(printf '%*s' "$MAX_IMAGE" '' | tr ' ' '-')" \
    "$(printf '%*s' "$MAX_CURRENT" '' | tr ' ' '-')" \
    "$(printf '%*s' "$MAX_LATEST" '' | tr ' ' '-')" \
    "----------"

for i in "${!REPO_URL[@]}"; do
    printf "%-${MAX_REPO}s  %-${MAX_IMAGE}s  %-${MAX_CURRENT}s  %-${MAX_LATEST}s  %s\n" \
        "${REPO_URL[$i]}" "${IMAGE_NAME[$i]}" "${CURRENT_VER[$i]}" "${LATEST_VER[$i]}" "${STATUS[$i]}"
done
