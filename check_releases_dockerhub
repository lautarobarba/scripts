#!/usr/bin/env bash

RELEASES_FILE="$HOME/Nextcloud/releases_dockerhub"
# # App[repository]:image:version
# Gitlab[https://github.com/lautarobarba/gitlab-container]:gitlab/gitlab-ce:18.6.4-ce.0
# Portainer[https://github.com/lautarobarba/portainer-swarm-container]:portainer/portainer-ce:2.21.5
# Traefik[https://github.com/lautarobarba/traefik-swarm-container]:traefik:v3.7
# Nextcloud[https://github.com/lautarobarba/nextcloud-container]:nextcloud:32.0


HEADER_REPO="Repo URL"
HEADER_IMAGE="Image"
HEADER_CURRENT="Current"
HEADER_LATEST="Latest"

REPO_URL=()
IMAGE_NAME=()
CURRENT_VER=()
LATEST_VER=()
STATUS=()
# Anchos minimos: el largo de cada encabezado
MAX_REPO=${#HEADER_REPO}
MAX_IMAGE=${#HEADER_IMAGE}
MAX_CURRENT=${#HEADER_CURRENT}
MAX_LATEST=${#HEADER_LATEST}

# Separa el registry del repositorio. Si el primer componente tiene un
# punto, dos puntos o es localhost, es un registry (ghcr.io, quay.io...).
#   nextcloud                 -> docker.io library/nextcloud
#   gitlab/gitlab-ce          -> docker.io gitlab/gitlab-ce
#   ghcr.io/goauthentik/server -> ghcr.io  goauthentik/server
resolve_image() {
    local image="$1" registry="docker.io" first="${1%%/*}"

    if [[ "$image" == */* && ( "$first" == *.* || "$first" == *:* || "$first" == localhost ) ]]; then
        registry="$first"
        image="${image#*/}"
    fi

    if [[ "$registry" == "docker.io" || "$registry" == "index.docker.io" ]]; then
        registry="docker.io"
        [[ "$image" != */* ]] && image="library/${image}"
    fi

    echo "$registry $image"
}

# Construye la expresion regular que describe la version actual:
# mismo prefijo (v), misma cantidad de componentes y mismo sufijo.
#   6.6.2       -> ^[0-9]+(\.[0-9]+){2}$
#   32.0        -> ^[0-9]+(\.[0-9]+){1}$
#   v3.7.6      -> ^v[0-9]+(\.[0-9]+){2}$
#   18.6.4-ce.0 -> ^[0-9]+(\.[0-9]+){2}-ce\.[0-9]+$
version_pattern() {
    local current="$1"
    local prefix="" core suffix suffix_re=""

    if [[ "$current" == v[0-9]* ]]; then
        prefix="v"
        current="${current#v}"
    fi

    [[ "$current" =~ ^([0-9]+(\.[0-9]+)*) ]] || return 1
    core="${BASH_REMATCH[1]}"
    suffix="${current#"$core"}"

    local dots="${core//[^.]/}"
    local depth=${#dots}

    if [[ -n "$suffix" ]]; then
        # Escapa los metacaracteres y generaliza los numeros del sufijo
        suffix_re=$(printf '%s' "$suffix" |
            sed -E -e 's/[][(){}.*+?^$|\\]/\\&/g' -e 's/[0-9]+/[0-9]+/g')
    fi

    printf '^%s[0-9]+(\\.[0-9]+){%d}%s$' "$prefix" "$depth" "$suffix_re"
}

# Pide un token anonimo usando el desafio WWW-Authenticate del registry
# (sirve para ghcr.io, quay.io, lscr.io, etc.).
registry_token() {
    local host="$1" api_image="$2" challenge realm service

    challenge=$(curl -s --max-time 15 -o /dev/null -D - \
        "https://${host}/v2/${api_image}/tags/list" |
        grep -i '^www-authenticate:' | tr -d '\r')
    [[ -z "$challenge" ]] && return 0

    realm=$(sed -nE 's/.*realm="([^"]*)".*/\1/p' <<< "$challenge")
    service=$(sed -nE 's/.*service="([^"]*)".*/\1/p' <<< "$challenge")
    [[ -z "$realm" ]] && return 0

    curl -s --max-time 15 -G "$realm" \
        ${service:+--data-urlencode "service=${service}"} \
        --data-urlencode "scope=repository:${api_image}:pull" |
        jq -r '.token // .access_token // empty' 2>/dev/null
}

# Recorre todas las paginas de /v2/<image>/tags/list siguiendo el header Link.
registry_tags() {
    local host="$1" api_image="$2" token="$3"
    local url="https://${host}/v2/${api_image}/tags/list?n=1000"
    local headers body next pages=0

    headers=$(mktemp)
    while [[ -n "$url" ]] && (( pages++ < 50 )); do
        body=$(curl -s --max-time 30 -D "$headers" \
            ${token:+-H "Authorization: Bearer ${token}"} "$url")
        jq -r '.tags[]?' <<< "$body" 2>/dev/null

        next=$(grep -i '^link:' "$headers" | sed -nE 's/.*<([^>]*)>.*/\1/p' | tr -d '\r')
        if [[ -z "$next" ]]; then
            url=""
        elif [[ "$next" == /* ]]; then
            url="https://${host}${next}"
        else
            url="$next"
        fi
    done
    rm -f "$headers"
}

# El registry devuelve todos los tags (paginados via Link).
# Para Docker Hub, si falla se usa su API (solo la primera pagina).
fetch_tags() {
    local registry="$1" api_image="$2" host="$1" token="" tags=""

    [[ "$registry" == "docker.io" ]] && host="registry-1.docker.io"

    token=$(registry_token "$host" "$api_image")
    tags=$(registry_tags "$host" "$api_image" "$token")

    if [[ -z "$tags" && "$registry" == "docker.io" ]]; then
        tags=$(curl -s --max-time 15 \
            "https://registry.hub.docker.com/v2/repositories/${api_image}/tags?page_size=100" |
            jq -r '.results[]?.name' 2>/dev/null)
    fi

    printf '%s\n' "$tags"
}

check_release() {
    local image="$1" current="$2"

    local pattern
    pattern=$(version_pattern "$current") || {
        echo "ERROR"
        return 1
    }

    local registry api_image tags
    read -r registry api_image <<< "$(resolve_image "$image")"
    tags=$(fetch_tags "$registry" "$api_image")

    if [[ -z "$tags" ]]; then
        echo "ERROR"
        return 1
    fi

    local latest
    latest=$(printf '%s\n' "$tags" | grep -E "$pattern" | sort -V | tail -n1)

    if [[ -z "$latest" ]]; then
        echo "ERROR"
        return 1
    fi

    echo "$latest"
    return 0
}

while IFS= read -r line; do
    [[ "$line" =~ ^#.* ]] && continue
    [[ -z "$line" ]] && continue

    repo_with_rest="${line#*[}"
    repo="${repo_with_rest%%]*}"
    rest="${repo_with_rest#*]:}"
    image="${rest%:*}"
    version="${rest##*:}"

    echo -n "Checking ${image}... " >&2
    latest=$(check_release "$image" "$version")
    echo "${latest}" >&2
    if [[ "$latest" == "ERROR" ]]; then
        status="ERROR"
    elif [[ "$version" == "$latest" ]]; then
        status="OK"
    elif [[ "$(printf '%s\n%s\n' "$version" "$latest" | sort -V | tail -n1)" == "$version" ]]; then
        # La version instalada es mas nueva que el ultimo tag encontrado
        status="OK"
    else
        status="Update Available"
    fi

    REPO_URL+=("$repo")
    IMAGE_NAME+=("$image")
    CURRENT_VER+=("$version")
    LATEST_VER+=("$latest")
    STATUS+=("$status")

    (( ${#repo} > MAX_REPO )) && MAX_REPO=${#repo}
    (( ${#image} > MAX_IMAGE )) && MAX_IMAGE=${#image}
    (( ${#version} > MAX_CURRENT )) && MAX_CURRENT=${#version}
    (( ${#latest} > MAX_LATEST )) && MAX_LATEST=${#latest}
done < "$RELEASES_FILE"

printf "%-${MAX_REPO}s  %-${MAX_IMAGE}s  %-${MAX_CURRENT}s  %-${MAX_LATEST}s  %s\n" \
    "$HEADER_REPO" "$HEADER_IMAGE" "$HEADER_CURRENT" "$HEADER_LATEST" "Status"
printf "%-${MAX_REPO}s  %-${MAX_IMAGE}s  %-${MAX_CURRENT}s  %-${MAX_LATEST}s  %s\n" \
    "$(printf '%*s' "$MAX_REPO" '' | tr ' ' '-')" \
    "$(printf '%*s' "$MAX_IMAGE" '' | tr ' ' '-')" \
    "$(printf '%*s' "$MAX_CURRENT" '' | tr ' ' '-')" \
    "$(printf '%*s' "$MAX_LATEST" '' | tr ' ' '-')" \
    "----------"

for i in "${!REPO_URL[@]}"; do
    printf "%-${MAX_REPO}s  %-${MAX_IMAGE}s  %-${MAX_CURRENT}s  %-${MAX_LATEST}s  %s\n" \
        "${REPO_URL[$i]}" "${IMAGE_NAME[$i]}" "${CURRENT_VER[$i]}" "${LATEST_VER[$i]}" "${STATUS[$i]}"
done
